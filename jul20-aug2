<script>
const tip = {
  backgroundColor: '#1a1916', titleColor: '#fff',
  bodyColor: 'rgba(255,255,255,0.7)', padding: 10, cornerRadius: 6, displayColors: false
};

// Feb, Mar, Apr, May, Jul6-19, Jul20-Aug2
// (skipping individual biweeklies for Jun to keep chart readable — using full period averages)
const LABELS = ['Feb','Mar','Apr','May','Jun 8–21','Jun 22–Jul 5','Jul 6–19','Jul 20–Aug 2'];

new Chart(document.getElementById('cReach'), {
  type: 'bar',
  data: {
    labels: LABELS,
    datasets: [
      {
        label: 'LI Impressions',
        data: [848, 3814, 1369, 1951, 1070, 384, 723, 1323],
        backgroundColor: (ctx) => ctx.dataIndex === 7 ? '#3568b0' : 'rgba(53,104,176,0.4)',
        borderRadius: 3, barPercentage: 0.7
      },
      {
        label: 'FB Reach',
        data: [140, 2430, 8568, 5067, 1372, 1079, 386, 292],
        backgroundColor: (ctx) => ctx.dataIndex === 7 ? '#238a57' : 'rgba(35,138,87,0.4)',
        borderRadius: 3, barPercentage: 0.7
      }
    ]
  },
  options: {
    responsive: true, maintainAspectRatio: false,
    plugins: { legend: { display: false }, tooltip: { ...tip } },
    scales: {
      x: { grid: { display: false }, ticks: { color: '#938f84', font: { size: 10 } } },
      y: { grid: { color: 'rgba(0,0,0,0.05)' }, ticks: { color: '#938f84', font: { size: 10 } } }
    }
  }
});

new Chart(document.getElementById('cER'), {
  type: 'line',
  data: {
    labels: LABELS,
    datasets: [
      {
        label: 'LI ER',
        data: [4.29, 4.64, 5.11, 4.82, 7.10, 8.81, 4.50, 3.11],
        borderColor: '#3568b0', backgroundColor: 'transparent',
        tension: 0.35, pointRadius: (ctx) => ctx.dataIndex === 7 ? 6 : 4,
        borderWidth: 2
      },
      {
        label: 'FB ER',
        data: [9.29, 7.20, 1.62, 2.43, 6.05, 5.93, 15.28, 12.67],
        borderColor: '#238a57', backgroundColor: 'transparent',
        tension: 0.35, pointRadius: (ctx) => ctx.dataIndex === 7 ? 6 : 4,
        borderWidth: 2, borderDash: [5, 3]
      }
    ]
  },
  options: {
    responsive: true, maintainAspectRatio: false,
    plugins: { legend: { display: false }, tooltip: { ...tip, callbacks: { label: ctx => ctx.dataset.label + ': ' + ctx.raw.toFixed(2) + '%' } } },
    scales: {
      x: { grid: { display: false }, ticks: { color: '#938f84', font: { size: 10 } } },
      y: { grid: { color: 'rgba(0,0,0,0.05)' }, ticks: { color: '#938f84', font: { size: 10 }, callback: v => v + '%' } }
    }
  }
});

new Chart(document.getElementById('cLP'), {
  type: 'bar',
  data: {
    labels: ['Mar', 'Apr', 'May', 'May 25–Jun 7', 'Jun 8–21', 'Jun 22–Jul 5', 'Jul 6–19', 'Jul 20–Aug 2'],
    datasets: [

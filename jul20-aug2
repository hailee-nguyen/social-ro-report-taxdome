<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Romania Social Media — Jul 20–Aug 2, 2026</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg: #f9f8f6;
  --surface: #ffffff;
  --surface-2: #f2f1ee;
  --border: #e4e2dc;
  --text-1: #1a1916;
  --text-2: #5a5850;
  --text-3: #938f84;
  --accent: #1a4f8a;
  --accent-light: #e8eef7;
  --accent-mid: #3b6db5;
  --green: #1a6644;
  --green-light: #e6f2ec;
  --red: #8a2a1a;
  --red-light: #f7ebe8;
  --amber: #7a5200;
  --amber-light: #fdf3e0;
  --teal: #0e5c52;
  --r: 8px;
  --r-lg: 12px;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  background: var(--bg);
  color: var(--text-1);
  font-size: 14px;
  line-height: 1.5;
}

.hd { background: var(--accent); color: #fff; padding: 36px 40px 30px; }
.hd-eye { font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.55; margin-bottom: 8px; }
.hd-title { font-size: 22px; font-weight: 600; line-height: 1.2; margin-bottom: 4px; }
.hd-sub { font-size: 13px; opacity: 0.6; margin-bottom: 18px; }
.hd-pills { display: flex; gap: 8px; flex-wrap: wrap; }
.hd-pill {
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.18);
  border-radius: 20px;
  font-size: 11.5px;
  padding: 3px 11px;
  color: rgba(255,255,255,0.8);
}

.wrap { max-width: 880px; margin: 0 auto; padding: 0 24px; }
.section { padding: 28px 0; border-bottom: 1px solid var(--border); }
.section:last-of-type { border-bottom: none; }
.sec-label {
  font-size: 10px; font-weight: 600; letter-spacing: 0.1em;
  text-transform: uppercase; color: var(--text-3); margin-bottom: 14px;
}

.kpi-row {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 10px;
}
@media (max-width: 700px) { .kpi-row { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 420px) { .kpi-row { grid-template-columns: repeat(2, 1fr); } }

.kpi {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  padding: 14px 14px 12px;
}
.kpi-lbl { font-size: 10px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-3); margin-bottom: 6px; line-height: 1.3; }
.kpi-val { font-size: 22px; font-weight: 600; line-height: 1; margin-bottom: 6px; }
.kpi-delta { font-size: 11px; font-weight: 500; }
.up { color: var(--green); }
.dn { color: var(--red); }
.nt { color: var(--text-3); }
.kpi-prev { font-size: 10.5px; color: var(--text-3); margin-top: 2px; }

.chart-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
@media (max-width: 580px) { .chart-pair { grid-template-columns: 1fr; } }

.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  padding: 16px 18px;
}
.card.full { grid-column: 1 / -1; }
.card-title { font-size: 12.5px; font-weight: 600; color: var(--text-1); margin-bottom: 2px; }
.card-sub { font-size: 11px; color: var(--text-3); margin-bottom: 12px; }
.chart-wrap { position: relative; }
.trend-note { font-size: 11px; color: var(--text-3); margin-top: 8px; font-style: italic; }

.leg { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 10px; }
.leg-item { display: flex; align-items: center; gap: 5px; font-size: 11px; color: var(--text-2); }
.leg-sq { width: 9px; height: 9px; border-radius: 2px; flex-shrink: 0; }
.leg-dash { width: 14px; height: 2px; flex-shrink: 0; background: var(--green); }

.analysis {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  padding: 16px 20px;
  margin-top: 14px;
}
.analysis-row {
  display: flex;
  gap: 10px;
  padding: 8px 0;
  border-bottom: 1px solid var(--border);
  align-items: flex-start;
}
.analysis-row:last-child { border-bottom: none; padding-bottom: 0; }
.analysis-row:first-child { padding-top: 0; }
.a-tag {
  font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
  padding: 2px 7px; border-radius: 3px; flex-shrink: 0; margin-top: 1px;
}
.a-tag.li   { background: var(--accent-light); color: var(--accent); }
.a-tag.fb   { background: #e8eef8; color: #2044a0; }
.a-tag.lp   { background: var(--green-light); color: var(--green); }
.a-tag.key  { background: var(--amber-light); color: var(--amber); }
.a-text { font-size: 13px; color: var(--text-2); line-height: 1.55; }
.a-text strong { color: var(--text-1); font-weight: 600; }

.camp-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
.camp-table th {
  font-size: 10px; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase;
  color: var(--text-3); text-align: left; padding: 0 10px 8px;
  border-bottom: 1px solid var(--border); white-space: nowrap;
}
.camp-table th:not(:first-child):not(:nth-child(2)) { text-align: right; }
.camp-table td {
  padding: 8px 10px; border-bottom: 1px solid var(--border);
  vertical-align: middle; color: var(--text-1);
}
.camp-table td:not(:first-child):not(:nth-child(2)) { text-align: right; }
.camp-table tbody tr:last-child td { border-bottom: none; }
.camp-table tbody tr:hover td { background: #fafaf8; }
.plat {
  display: inline-block; font-size: 9.5px; font-weight: 700;
  letter-spacing: 0.06em; text-transform: uppercase;
  padding: 2px 6px; border-radius: 3px;
}
.plat.li { background: var(--accent-light); color: var(--accent); }
.plat.fb { background: #e8eef8; color: #2044a0; }
.post-name { font-weight: 500; }
.post-type { font-size: 11px; color: var(--text-3); }
.top { background: #fffbf0; }
.top td { border-bottom: 1px solid var(--border); }
.zero .post-name { color: var(--text-3); }
.zero td { color: var(--text-3); }

.ft {
  border-top: 1px solid var(--border);
  padding: 16px 40px;
  font-size: 11px; color: var(--text-3);
  display: flex; justify-content: space-between; flex-wrap: wrap; gap: 6px;
}
</style>
</head>
